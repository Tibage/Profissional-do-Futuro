{
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.js"
    },
    {
      "source": "/style.css",
      "destination": "/api/index.js"
    },
    {
      "source": "/script.js",
      "destination": "/api/index.js"
    },
    {
      "source": "/imagens/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
